#!/bin/sh
#
# Enforce the trailer rules from AGENTS.md.
#
# Bypass with "git commit --no-verify". This is a guard against mistakes,
# not a security boundary: the remote requires GPG-signed commits.
#
# Keep this file portable: BSD grep, sed, and awk do not understand the
# GNU extensions (grep -E is fine, sed \+ and sed I are not).

msg_file=$1

fail () {
	echo "commit-msg: $1" >&2
	echo "commit-msg: see AGENTS.md, section 'Commit rules'" >&2
	exit 1
}

trailers=$(git interpret-trailers --parse "$msg_file")

if ! printf '%s\n' "$trailers" | grep -Eqi '^co-authored-by: .+ <.+@.+>$'; then
	fail "missing or malformed Co-authored-by trailer"
fi

signoff=$(printf '%s\n' "$trailers" |
	awk 'tolower($0) ~ /^signed-off-by:/ { print; exit }' |
	sed -n 's/.*<\([^>]*\)>.*/\1/p')

if [ -z "$signoff" ]; then
	fail "missing or malformed Signed-off-by trailer"
fi

committer=$(git var GIT_COMMITTER_IDENT | sed -n 's/.*<\([^>]*\)>.*/\1/p')
if [ "$signoff" != "$committer" ]; then
	fail "Signed-off-by address '$signoff' does not match committer '$committer'"
fi

exit 0
