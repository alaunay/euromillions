#: euromillions.sh:157 euromillions.sh:420
msgid "Numbers"
msgstr "Numéros"

#: euromillions.sh:159
msgid "no translation for %s, using English"
msgstr "pas de traduction pour %s, sortie en anglais"

#: euromillions.sh:191
msgid "Usage:"
msgstr "Utilisation :"

#: euromillions.sh:192
msgid "Draw %s numbers from %s to %s and %s stars from %s to %s."
msgstr "Tirer %s numéros de %s à %s et %s étoiles de %s à %s."

#: euromillions.sh:195
msgid "Options:"
msgstr "Options :"

#: euromillions.sh:196
msgid "output language, overriding the locale"
msgstr "langue de sortie, prioritaire sur la locale"

#: euromillions.sh:197
msgid "never use colours"
msgstr "ne jamais utiliser de couleurs"

#: euromillions.sh:198
msgid "show this help"
msgstr "afficher cette aide"

#: euromillions.sh:199
msgid "Languages:"
msgstr "Langues :"

#: euromillions.sh:222
msgid "draw failed"
msgstr "tirage impossible"

#: euromillions.sh:229
msgid "short draw"
msgstr "tirage incomplet"

#: euromillions.sh:245
msgid "invalid ALERT_DAYS: %s"
msgstr "ALERT_DAYS invalide : %s"

#: euromillions.sh:277
msgid "alert: no mailer found, set ALERT_MAILER"
msgstr "alerte : aucun outil d'envoi, définissez ALERT_MAILER"

#: euromillions.sh:297
msgid "alert: curl is not installed"
msgstr "alerte : curl n'est pas installé"

#: euromillions.sh:303
msgid "alert: cannot read the jackpot from %s"
msgstr "alerte : impossible de lire le jackpot depuis %s"

#: euromillions.sh:311
msgid "alert: the jackpot response is invalid"
msgstr "alerte : la réponse du jackpot est invalide"

#: euromillions.sh:340
msgid "invalid ALERT_THRESHOLD: %s"
msgstr "ALERT_THRESHOLD invalide : %s"

#: euromillions.sh:348 euromillions.sh:356
msgid "possible gain next time: %s€"
msgstr "gain possible au prochain tirage : %s€"

#: euromillions.sh:351
msgid "alert: ALERT_TO is not set, no mail sent"
msgstr "alerte : ALERT_TO n'est pas défini, aucun mail envoyé"

#: euromillions.sh:355
msgid "Euromillions: possible gain next time: %s€"
msgstr "Euromillions : gain possible au prochain tirage : %s€"

#: euromillions.sh:402
msgid "option %s needs a language code"
msgstr "l'option %s attend un code de langue"

#: euromillions.sh:409
msgid "unknown argument: %s"
msgstr "argument inconnu : %s"

#: euromillions.sh:421
msgid "Stars"
msgstr "Étoiles"

