#: euromillions.sh:157 euromillions.sh:465
msgid "Numbers"
msgstr "Numéros"

#: euromillions.sh:159
msgid "no translation for %s, using English"
msgstr "pas de traduction pour %s, sortie en anglais"

#: euromillions.sh:191
msgid "Usage:"
msgstr "Utilisation :"

#: euromillions.sh:192
msgid "Draw %s numbers from %s to %s and %s stars from %s to %s."
msgstr "Tirer %s numéros de %s à %s et %s étoiles de %s à %s."

#: euromillions.sh:195
msgid "Options:"
msgstr "Options :"

#: euromillions.sh:196
msgid "output language, overriding the locale"
msgstr "langue de sortie, prioritaire sur la locale"

#: euromillions.sh:197
msgid "mail the next jackpot when it reaches the threshold"
msgstr "envoyer le prochain jackpot par mail dès qu'il atteint le seuil"

#: euromillions.sh:198
msgid "print the alert threshold and exit"
msgstr "afficher le seuil d'alerte et quitter"

#: euromillions.sh:199
msgid "never use colours"
msgstr "ne jamais utiliser de couleurs"

#: euromillions.sh:200
msgid "show this help"
msgstr "afficher cette aide"

#: euromillions.sh:201
msgid "Languages:"
msgstr "Langues :"

#: euromillions.sh:224
msgid "draw failed"
msgstr "tirage impossible"

#: euromillions.sh:231
msgid "short draw"
msgstr "tirage incomplet"

#: euromillions.sh:268
msgid "invalid ALERT_THRESHOLD: %s"
msgstr "ALERT_THRESHOLD invalide : %s"

#: euromillions.sh:290
msgid "alert: no mailer found, set ALERT_MAILER"
msgstr "alerte : aucun outil d'envoi, définissez ALERT_MAILER"

#: euromillions.sh:298 euromillions.sh:304
msgid "alert: the mailer failed"
msgstr "alerte : l'envoi du mail a échoué"

#: euromillions.sh:316
msgid "alert: curl is not installed"
msgstr "alerte : curl n'est pas installé"

#: euromillions.sh:322
msgid "alert: cannot read the jackpot from %s"
msgstr "alerte : impossible de lire le jackpot depuis %s"

#: euromillions.sh:330
msgid "alert: the jackpot response is invalid"
msgstr "alerte : la réponse du jackpot est invalide"

msgid "EUROMILLIONS - NEXT DRAW"
msgstr "EUROMILLIONS - PROCHAIN TIRAGE"

msgid "Jackpot:"
msgstr "Jackpot :"

msgid "Play:"
msgstr "Jouer :"

msgid "Fill a grid before the draw. Good luck!"
msgstr "Remplissez une grille avant le tirage. Bonne chance !"

#: euromillions.sh:374
msgid "alert: ALERT_TO is not set, no mail sent"
msgstr "alerte : ALERT_TO n'est pas défini, aucun mail envoyé"

msgid "Euromillions: %s next jackpot"
msgstr "Euromillions : %s au prochain tirage"

#: euromillions.sh:435
msgid "option %s needs a language code"
msgstr "l'option %s attend un code de langue"

#: euromillions.sh:442
msgid "unknown argument: %s"
msgstr "argument inconnu : %s"

#: euromillions.sh:466
msgid "Stars"
msgstr "Étoiles"
